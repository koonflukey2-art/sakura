# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/sakura?schema=public"

# JWT
# IMPORTANT: Generate a secure random string for production!
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, a random secret will be generated in development (tokens won't persist across restarts)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# AI Services
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:9002"
