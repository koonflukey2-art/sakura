# Database Configuration
# Neon PostgreSQL Database URL
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_PWIu27ZMFmVi@ep-cool-bush-a4aa39yx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
# Generate a secure random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# AI API Keys
# OpenAI API Key (for GPT models)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google Gemini API Key (for Gemini models)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSyB4-GnCIFzIwpF8HLA6Hdfv5-NssIytg4g

# Frontend Configuration (for Next.js app)
# API URL that the frontend will connect to
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: Email Configuration (if you want to add email notifications later)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

