// Sakura Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management & Authentication
// ============================================

enum UserRole {
  ADMIN              // แอดมินใหญ่ - สิทธิ์เต็ม
  STAFF_STOCK        // พนักงานสต๊อก
  STAFF_MARKETING    // พนักงานการตลาด
  VIEWER             // ผู้ชม - ดูอย่างเดียว
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String      @map("password_hash")
  name          String
  phone         String?
  role          UserRole    @default(VIEWER)
  status        UserStatus  @default(ACTIVE)

  // Relations
  budgetRequests       BudgetRequest[]
  approvedBudgets      BudgetRequest[]  @relation("BudgetApprover")
  notifications        Notification[]
  aiLogs              AiLog[]
  createdCampaigns    Campaign[]

  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

// ============================================
// Stock Management
// ============================================

enum StockStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum ShippingStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model StockItem {
  id              String          @id @default(cuid())
  name            String
  code            String          @unique
  description     String?
  location        String?         // คลัง/สาขา

  priceCost       Decimal         @map("price_cost")       @db.Decimal(10, 2)
  priceSell       Decimal         @map("price_sell")       @db.Decimal(10, 2)
  quantity        Int             @default(0)
  minThreshold    Int             @default(10) @map("min_threshold")

  status          StockStatus     @default(ACTIVE)
  shippingStatus  ShippingStatus? @map("shipping_status")

  // Relations
  orderItems      OrderItem[]

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("stock_items")
}

// ============================================
// Customer Management
// ============================================

model Customer {
  id              String      @id @default(cuid())
  name            String
  email           String?     @unique
  phone           String?

  firstOrderDate  DateTime?   @map("first_order_date")
  totalOrders     Int         @default(0) @map("total_orders")
  totalSpent      Decimal     @default(0) @map("total_spent") @db.Decimal(12, 2)

  // Relations
  orders          Order[]

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("customers")
}

// ============================================
// Orders & Sales
// ============================================

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  customerId      String        @map("customer_id")

  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalCost       Decimal       @map("total_cost")   @db.Decimal(12, 2)
  profit          Decimal       @db.Decimal(12, 2)

  status          OrderStatus   @default(PENDING)

  // Relations
  customer        Customer      @relation(fields: [customerId], references: [id])
  orderItems      OrderItem[]

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String      @map("order_id")
  stockItemId     String      @map("stock_item_id")

  quantity        Int
  priceSell       Decimal     @map("price_sell") @db.Decimal(10, 2)
  priceCost       Decimal     @map("price_cost") @db.Decimal(10, 2)
  lineTotal       Decimal     @map("line_total") @db.Decimal(12, 2)

  // Relations
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItem       StockItem   @relation(fields: [stockItemId], references: [id])

  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("order_items")
}

// ============================================
// Budget Management
// ============================================

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum BudgetDepartment {
  STOCK
  MARKETING
  OPERATIONS
  OTHER
}

model BudgetSettings {
  id                String          @id @default(cuid())
  period            BudgetPeriod    @default(MONTHLY)

  companyBudget     Decimal         @map("company_budget")     @db.Decimal(12, 2)
  stockBudget       Decimal         @map("stock_budget")       @db.Decimal(12, 2)
  marketingBudget   Decimal         @map("marketing_budget")   @db.Decimal(12, 2)
  operationsBudget  Decimal         @map("operations_budget")  @db.Decimal(12, 2)

  startDate         DateTime        @map("start_date")
  endDate           DateTime        @map("end_date")

  isActive          Boolean         @default(true) @map("is_active")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("budget_settings")
}

enum BudgetRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model BudgetRequest {
  id              String                @id @default(cuid())
  userId          String                @map("user_id")
  approvedBy      String?               @map("approved_by")

  department      BudgetDepartment
  amount          Decimal               @db.Decimal(12, 2)
  reason          String
  status          BudgetRequestStatus   @default(PENDING)

  approvedAt      DateTime?             @map("approved_at")
  rejectionReason String?               @map("rejection_reason")

  // Relations
  user            User                  @relation(fields: [userId], references: [id])
  approver        User?                 @relation("BudgetApprover", fields: [approvedBy], references: [id])

  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@map("budget_requests")
}

// ============================================
// Campaign & Platform Management
// ============================================

enum CampaignPlatform {
  FACEBOOK
  GOOGLE
  TIKTOK
  LINE
  INSTAGRAM
  WEBSITE
  OTHER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String            @id @default(cuid())
  name            String
  platform        CampaignPlatform

  budget          Decimal           @db.Decimal(12, 2)
  spent           Decimal           @default(0) @db.Decimal(12, 2)
  revenue         Decimal           @default(0) @db.Decimal(12, 2)

  status          CampaignStatus    @default(ACTIVE)
  settingsJson    Json?             @map("settings_json")

  createdById     String            @map("created_by_id")
  createdBy       User              @relation(fields: [createdById], references: [id])

  // Metrics
  impressions     Int               @default(0)
  clicks          Int               @default(0)
  conversions     Int               @default(0)

  startDate       DateTime?         @map("start_date")
  endDate         DateTime?         @map("end_date")

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("campaigns")
}

// ============================================
// Notifications
// ============================================

enum NotificationType {
  BUDGET_REQUEST
  BUDGET_APPROVED
  BUDGET_REJECTED
  STOCK_LOW
  AI_SUGGESTION
  ORDER_NEW
  SYSTEM
}

model Notification {
  id              String            @id @default(cuid())
  userId          String            @map("user_id")

  type            NotificationType
  title           String
  message         String
  dataJson        Json?             @map("data_json")

  isRead          Boolean           @default(false) @map("is_read")

  // Relations
  user            User              @relation(fields: [userId], references: [id])

  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("notifications")
}

// ============================================
// AI Logs
// ============================================

model AiLog {
  id              String      @id @default(cuid())
  userId          String      @map("user_id")

  page            String      // หน้าไหนที่ใช้ AI
  action          String      // action อะไร
  requestPrompt   String      @map("request_prompt") @db.Text
  response        String      @db.Text

  provider        String      @default("gpt") // "gpt" หรือ "gemini"
  tokensUsed      Int?        @map("tokens_used")

  // Relations
  user            User        @relation(fields: [userId], references: [id])

  createdAt       DateTime    @default(now()) @map("created_at")

  @@map("ai_logs")
}
